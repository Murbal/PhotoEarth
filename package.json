{
  "name": "photoearth",
  "productName": "PhotoEarth",
  "version": "0.1.0",
  "description": "A desktop 3D globe for photography location scouting.",
  "main": "./out/main/index.js",
  "author": "PhotoEarth",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env VITE_PHOTOEARTH_TEST=1 electron-vite build && playwright test",
    "package": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux",
    "build:test": "cross-env VITE_PHOTOEARTH_TEST=1 electron-vite build"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@photostructure/tz-lookup": "^11.8.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "astronomy-engine": "^2.1.19",
    "cesium": "^1.147.0",
    "cross-env": "^10.1.0",
    "egm96-universal": "^1.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
